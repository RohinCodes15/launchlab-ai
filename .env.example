# LaunchLab AI runs fully offline with no configuration. Copy this file to .env.local
# only if you want to turn on the optional real AI coach.

# "offline" (default): rule-based coach, no network calls, no cost.
# "anthropic": send idea text to Claude for feedback. Requires ANTHROPIC_API_KEY.
AI_PROVIDER=offline

# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit a real key.
ANTHROPIC_API_KEY=

# Optional. Model used when AI_PROVIDER=anthropic.
AI_MODEL=claude-opus-5-5

# Optional. Coach requests allowed per client per minute (1 to 1000). Default 12.
COACH_RATE_LIMIT_PER_MINUTE=
